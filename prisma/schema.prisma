// Prisma schema — Redação Nota Máxima AI
//
// Usamos SQLite em desenvolvimento (zero-config). Para produção,
// recomenda-se PostgreSQL — basta trocar o provider e DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Uma redação completa (rascunho ou finalizada) salva pelo usuário.
model Redacao {
  id            String   @id @default(cuid())
  titulo        String?
  area          String?
  tema          String   // enunciado completo
  tese          String   @default("")
  textoFinal    String   @default("")
  // Planejamento arquitetado salvo como JSON (estrutura imutável por redação)
  arquitetura   String?  // JSON serializado — Argumento[]
  intervencao   String?  // JSON serializado — PropostaIntervencao
  // Métricas de avaliação
  notaEstimada  Int?
  revisaoJson   String?  // JSON serializado da última RevisaoResultado
  // Sessão
  tempoSessaoMs Int?     // tempo total decorrido quando finalizada
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  finalizadaEm  DateTime?

  @@index([createdAt])
}
